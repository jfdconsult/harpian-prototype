# HARPIAN Portfolio Engineering Terminal — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it's in .gitignore

# ── Anthropic Claude (required for JD NEWS pipeline) ──────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Flask API ──────────────────────────────────────────────────────────────
PORT=5050
SECRET_KEY=change-me-to-a-random-secret-key-in-production
DEMO_MODE=true

# ── AlphaDroid (0JP: obter com a equipe HARPIAN) ──────────────────────────
ALPHADROID_API_URL=https://api.alphadroid.com/v4
ALPHADROID_API_KEY=

# ── Lynx Execution (0JP: credenciais da corretora) ────────────────────────
LYNX_API_URL=https://api.lynx.harpian.io/v1
LYNX_API_KEY=

# ── Market Data (opcional — yfinance não precisa de key) ──────────────────
# BLOOMBERG_API_KEY=
# REFINITIV_API_KEY=

# ── Custodians (opcional) ─────────────────────────────────────────────────
# BTG_API_KEY=
# BTG_API_SECRET=
# XP_API_KEY=
# XP_API_SECRET=

# ── JD NEWS (login das fontes pagas) ─────────────────────────────────────
BLOOMBERG_EMAIL=
BLOOMBERG_PASSWORD=
VALOR_EMAIL=
VALOR_PASSWORD=
